APP_NAME=静页书房
APP_ENV=development
DEBUG=true
DATABASE_URL=mysql+pymysql://ebook:change-me@db:3306/ebook_index?charset=utf8mb4
MYSQL_DATABASE=ebook_index
MYSQL_USER=ebook
MYSQL_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-root-password
PUBLIC_BASE_URL=http://localhost:8000
SESSION_SECRET=replace-with-a-long-random-value
SESSION_HTTPS_ONLY=false
LOCAL_STORAGE_ROOT=D:/ebook-transfer
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-before-first-run
IMPORT_MAX_ROWS=500
IMPORT_MAX_BYTES=5242880
LINK_CHECK_TIMEOUT_SECONDS=8
LINK_CHECK_AUTOMATIC_ENABLED=true
LINK_CHECK_INTERVAL_MINUTES=360
LINK_CHECK_POLL_SECONDS=60
LINK_CHECK_BATCH_SIZE=10
LINK_CHECK_ERROR_THRESHOLD=2
CLOUD_UPLOAD_WORKER_ENABLED=true
CLOUD_UPLOAD_POLL_SECONDS=2
CLOUD_UPLOAD_MAX_SCAN_FILES=300
CLOUD_UPLOAD_TIMEOUT_SECONDS=21600
# 多个允许扫描的本地目录用英文分号分隔。本地测试可填 D:/电子书存放
CLOUD_UPLOAD_SOURCE_ROOTS=D:/电子书存放
# 百度网盘正式使用请填写你自己的开放平台 Client ID 和授权令牌
BAIDU_NETDISK_CLIENT_ID=
BAIDU_NETDISK_ACCESS_TOKEN=
BAIDU_NETDISK_REMOTE_DIR=/静页书房
# 如系统找不到 node，可填写 node.exe 的绝对路径
# CLOUD_NODE_EXECUTABLE=C:/Program Files/nodejs/node.exe
# 夸克官方连接器由后台安装，通常无需手动填写
# QUARK_CLI_PATH=D:/ebook-transfer/cloud-connectors/quark/scripts/quark-drive.cjs

# 本地整理软件对接。正式站点改为唯一编号，软件中填写相同编号。
ORGANIZER_SITE_ID=jingye-local
# 图片域名白名单，只填主机名，不带协议、路径；多个用英文逗号分隔。
ORGANIZER_COVER_HOSTS=
ORGANIZER_MAX_BYTES=5242880
