# 这是正式服务器的配置样例，不要把真实密码提交 GitHub。
# 运行 bash deploy.sh 后会交互填写域名，并生成 deploy/.env。
# 不读取、不覆盖项目根目录供本地开发使用的 .env。
SITE_DOMAIN=
APP_NAME=书库
COMPOSE_PROJECT_NAME=ebook-site
ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
SESSION_SECRET=
MYSQL_DATABASE=ebook_index
MYSQL_USER=ebook
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
ORGANIZER_SITE_ID=
# 可选，封面域名和网站域名独立，只填主机名，多个用逗号分隔。
ORGANIZER_COVER_HOSTS=
# 未联调前不自动检查已有网盘链接，也不自动启动上传队列。
LINK_CHECK_AUTOMATIC_ENABLED=false
